{
  "name": "nyt-swiss-knife",
  "private": true,
  "version": "0.7.3",
  "description": "Independent tools for NYT puzzle games",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "test:browser": "python3 scripts/browser-tests.py",
    "check": "node scripts/check.cjs",
    "package": "python3 scripts/package.py",
    "preview": "python3 -m http.server 8765 --bind 127.0.0.1",
    "assets": "node scripts/generate-icons.cjs",
    "package:publish": "python3 scripts/prepare-publish.py",
    "verify:package": "node scripts/verify-package.cjs",
    "update": "node scripts/update.cjs",
    "release": "node scripts/update.cjs --release",
    "version:set": "node scripts/version.cjs"
  }
}
